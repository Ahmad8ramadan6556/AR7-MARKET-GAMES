# انسخ هذا الملف باسم .env محلياً، ولا ترفعه أبداً إلى GitHub
# في Railway لا تحتاج ملف .env؛ تضاف هذه القيم من إعدادات Variables مباشرة

PORT=3000
SESSION_SECRET=غير_هذه_القيمة_لسلسلة_عشوائية_طويلة

# بيانات دخول المالك (كلمة السر يجب أن تكون Hash وليست نص عادي - راجع README)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=

# Google OAuth (من Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (من Facebook Developers)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
